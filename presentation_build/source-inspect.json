      {
        "id": "sh/10b2dk7a",
        "kind": "textbox",
        "text": "Data Used",
        "position": {
          "left": 63.99,
          "top": 28.65,
          "width": 1152,
          "height": 120.19
        },
        "style": {
          "fontSize": 64,
          "typeface": "Times New Roman",
          "color": "#FF0000",
          "alignment": "center"
        }
      },
      {
        "id": "sh/q903y5on",
        "kind": "textbox",
        "text": "Source of data: CampusFAQ-50K (a synthetic controlled benchmark) and an institutional knowledge base (academic calendar, regulations, curriculum).\nType of data: Unstructured text (official university documents) and structured question-answering pairs.\nNumber of records: 50,000 records in the CampusFAQ-50K benchmark, spanning 24 intents.\nImportant attributes/columns: Query, intent, answerable, expected_evidence, difficulty, and source.\nData format: CSV files for datasets, JSON for structured lookups, and standard documents (PDFs/TXT) for the institutional knowledge base.\nTrain/test split: Stratified 80/20 split by intent: 40,000 training and 10,000 testing samples, preserving the proportion of all 24 intent classes to prevent class imbalance and ensure reliable evaluation on unseen data.",
        "position": {
          "left": 63.99,
          "top": 158.17,
          "width": 1152,
          "height": 523.84
        },
        "style": {
          "fontSize": 26.67,
          "typeface": "Times New Roman",
          "color": "#000000",
          "bold": true,
          "alignment": "left"
        }
      }
    ]
  },
